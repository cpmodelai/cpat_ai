# Database: 'dummy' (the default edition of this repository, data/editions.csv; CPAT_DATA_EDITION to choose another)
# or 'full' (the tidy folder of the Full01 edition, in the private data repository, below)
DATA_ENVIRONMENT=dummy

# Path of the full database (tidy folder in the private repository)
FULL_DATA_PATH=/absolute/path/to/private/data/Full01/tidy
